      "link": null,
      "locked": false,
      "text": "Begge implementerer samme kontrakt.\nCore trenger ikke vite hvilken av disse som faktisk brukes.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Begge implementerer samme kontrakt.\nCore trenger ikke vite hvilken av disse som faktisk brukes.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
