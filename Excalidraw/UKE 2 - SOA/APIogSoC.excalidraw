    {
      "id": "gaNu_hM8070ziPM95LaRD",
      "type": "text",
      "x": 524.5631578482825,
      "y": 5160.641778144115,
      "width": 436.2136164188922,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3u",
      "roundness": null,
      "seed": 721042889,
      "version": 390,
      "versionNonce": 1066264754,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792138736338,
      "created": 1791292738931,
      "link": null,
      "locked": false,
      "text": "API-arkitektur:\nHvordan vi strukturerer én API-tjeneste\nog ansvarsområdene inni den.\n\nSOC -> Loose coupling:\nÅ dele applikasjonen inn i lag med tydelige\nansvarsområder. Det fører til \"Loose\nCoupling\" \n\nEndringer i ett lag skal ikke føre til at vi må\nendre andre lag.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API-arkitektur:\nHvordan vi strukturerer én API-tjeneste\nog ansvarsområdene inni den.\n\nSOC -> Loose coupling:\nÅ dele applikasjonen inn i lag med tydelige ansvarsområder. Det fører til \"Loose Coupling\" \n\nEndringer i ett lag skal ikke føre til at vi må endre andre lag.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "GGSaFsI5RHI-nZgStl841",
      "type": "text",
      "x": 136.73891022141163,
      "y": 3333.3371136982505,
      "width": 582.8929268965164,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3v",
      "roundness": null,
      "seed": 1787178466,
      "version": 369,
      "versionNonce": 964069054,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791457943959,
      "created": 1791456942420,
      "link": null,
      "locked": false,
      "text": "Frontend skal ikke kunne bestemme alle egenskapene på en\nTask. id skal genereres av backend, og isCompleted skal\nbestemmes av backend.\n\nDerfor bruker vi en Data transfer Object (DTO) som\nbeskriver hvilke data frontend får sende inn.\nCreateTaskRequest trenger bare title.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Frontend skal ikke kunne bestemme alle egenskapene på en Task. id skal genereres av backend, og isCompleted skal bestemmes av backend.\n\nDerfor bruker vi en Data transfer Object (DTO) som beskriver hvilke data frontend får sende inn.\nCreateTaskRequest trenger bare title.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "VlA6nsVx6Vvg4EeLNWfz6",
      "type": "text",
      "x": 192.45668455966447,
      "y": 3529.1814555783676,
      "width": 479.09979248046875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3w",
      "roundness": null,
      "seed": 539364258,
      "version": 152,
      "versionNonce": 682819326,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791457943959,
      "created": 1791457480516,
      "link": null,
      "locked": false,
      "text": "HTTP (JSON) -> DTO -> Core (C#) -> TaskItem",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTTP (JSON) -> DTO -> Core (C#) -> TaskItem",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "P7BBnh9kRxAEfOXWhTj3U",
      "type": "text",
      "x": 149.13278682083688,
      "y": 3574.165149520204,
      "width": 565.7978471101083,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3x",
      "roundness": null,
      "seed": 1315621822,
      "version": 117,
      "versionNonce": 685402530,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791457948033,
      "created": 1791457931451,
      "link": null,
      "locked": false,
      "text": "DTO brukes for å kontrollere og begrense hvilke data\nAPI-et mottar eller returnerer, i stedet for å eksponere\nhele domenemodellen.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DTO brukes for å kontrollere og begrense hvilke data API-et mottar eller returnerer, i stedet for å eksponere hele domenemodellen.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
