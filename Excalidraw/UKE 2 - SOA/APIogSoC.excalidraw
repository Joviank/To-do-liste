    {
      "id": "EP8qJX_PkoxIbCJ5Xlels",
      "type": "text",
      "x": 472.35061125819396,
      "y": 4284.261509309192,
      "width": 535.403726512473,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3h",
      "roundness": null,
      "seed": 1737519335,
      "version": 179,
      "versionNonce": 54651966,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791456871506,
      "created": 1791291755157,
      "link": null,
      "locked": false,
      "text": "Det betyr bare at Core forholder seg til et interface\n(ITaskRepository), ikke til en bestemt implementasjon\nsom f.eks. EfTaskRepository",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Det betyr bare at Core forholder seg til et interface (ITaskRepository), ikke til en bestemt implementasjon som f.eks. EfTaskRepository",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "9aI_KSUbtqeqKFrLHMgAR",
      "type": "text",
      "x": 332.6181474025566,
      "y": 4413.947967262247,
      "width": 838.9807985285785,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3i",
      "roundness": null,
      "seed": 581601929,
      "version": 225,
      "versionNonce": 1056289918,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791456871506,
      "created": 1791291795138,
      "link": null,
      "locked": false,
      "text": "TLDR:\nCore sier hva den trenger, mens repositoryet bestemmer hvordan det gjøres.\n\nDerfor kan vi bytte mellom EfTaskRepository og FakeTaskRepository uten å endre\nCore.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TLDR:\nCore sier hva den trenger, mens repositoryet bestemmer hvordan det gjøres.\n\nDerfor kan vi bytte mellom EfTaskRepository og FakeTaskRepository uten å endre Core.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "5GtqVocklueMePQ0x7qZ5",
      "type": "rectangle",
      "x": 367.9143538128406,
      "y": 4022.506940901534,
      "width": 717.0084924957187,
      "height": 266.95870352300153,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3j",
      "roundness": {
        "type": 3
      },
      "seed": 1850410727,
      "version": 85,
      "versionNonce": 662516393,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791291823220,
      "created": 1791291819519,
      "link": null,
      "locked": false
    },
    {
      "id": "b8_J0hLmbRWQtS9GIZ1qV",
      "type": "text",
      "x": 335.6456812795557,
      "y": 4568.09632729242,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3k",
      "roundness": null,
      "seed": 563253833,
      "version": 257,
      "versionNonce": 428242110,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791456871506,
      "created": 1791291942978,
      "link": null,
      "locked": false,
      "text": "Takket vær Dependency inversion kan vi bytte EfTaskRepository med noe annet\ndersom vi ønsker å gå over fra EF Core til:",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Takket vær Dependency inversion kan vi bytte EfTaskRepository med noe annet dersom vi ønsker å gå over fra EF Core til:",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "OuLvShVih8htq_1fwEe2E",
      "type": "text",
      "x": 454.5823131055254,
      "y": 4636.611826514554,
      "width": 665.9794921875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3l",
      "roundness": null,
      "seed": 2128311817,
      "version": 224,
      "versionNonce": 479538430,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791456871506,
      "created": 1791291978882,
      "link": null,
      "locked": false,
      "text": "1. SqlTaskRepository - bruker SQL direkte, uten EF Core\n2. DapperTaskRepository - bruker Dapper\n3. MongoDbTaskRepository - bruker MongoDB\n4. FileTaskRepository - lagrer tasks i en fil\n5. ApiTaskRepository - henter/lagrer data gjennom et eksternt API",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. SqlTaskRepository - bruker SQL direkte, uten EF Core\n2. DapperTaskRepository - bruker Dapper\n3. MongoDbTaskRepository - bruker MongoDB\n4. FileTaskRepository - lagrer tasks i en fil\n5. ApiTaskRepository - henter/lagrer data gjennom et eksternt API",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
