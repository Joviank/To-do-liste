    {
      "id": "aYnqdeRDGktIM0V4DEgKx",
      "type": "text",
      "x": 324.5788607288682,
      "y": 3387.2361703965153,
      "width": 800,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3w",
      "roundness": null,
      "seed": 1665624683,
      "version": 211,
      "versionNonce": 602286469,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791834709785,
      "created": 1791834271560,
      "link": null,
      "locked": false,
      "text": "Hva er JSON?\nJSON er et standardisert format for å strukturere og utveksle data mellom\nsystemer. Et felles språk som gjør at frontend og backend kan forstå hvilke data\nsom sendes mellom dem. Tenk på det som \"Engelsk\" av datautveksling\n\nJSON er IKKE et programmeringsspråk. Det inneholder ingen logikk eller\ninstruksjoner som utfører handlinger. JSON beskriver bare data i et strukturert\nformat som programmene kan lese og behandle.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hva er JSON?\nJSON er et standardisert format for å strukturere og utveksle data mellom systemer. Et felles språk som gjør at frontend og backend kan forstå hvilke data som sendes mellom dem. Tenk på det som \"Engelsk\" av datautveksling\n\nJSON er IKKE et programmeringsspråk. Det inneholder ingen logikk eller instruksjoner som utfører handlinger. JSON beskriver bare data i et strukturert format som programmene kan lese og behandle.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
