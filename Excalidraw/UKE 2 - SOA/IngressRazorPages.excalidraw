      "updated": 1791832952191,
      "created": 1791832852135,
      "link": null,
      "locked": false,
      "text": "Vi bruker nettsider som Elkjøp i hverdagen uten å tenke over hva som skjer. ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vi bruker nettsider som Elkjøp i hverdagen uten å tenke over hva som skjer. ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "vp0MLhgNzH-4hRJvHzWv2",
      "type": "text",
      "x": 423.07403626016287,
      "y": 2722.1028063378835,
      "width": 622.6195068359375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3g",
      "roundness": null,
      "seed": 546220677,
      "version": 89,
      "versionNonce": 340467819,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791834208632,
      "created": 1791833382781,
      "link": null,
      "locked": false,
      "text": "Frontend er den delen av applikasjonen brukeren samhandler med",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Frontend er den delen av applikasjonen brukeren samhandler med",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "0Ro51M9hwzAWwzwKMmW8B",
      "type": "text",
      "x": 356.9911395867765,
      "y": 3116.7870512702075,
      "width": 785.8594360351562,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3h",
      "roundness": null,
      "seed": 1456530757,
      "version": 147,
      "versionNonce": 1168339659,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791834139028,
      "created": 1791833402182,
      "link": null,
      "locked": false,
      "text": "Eksempel: Hente oppgaver\n\nNår frontend skal hente oppgaver fra backend, kan kommunikasjonen foregå slik:\n\n1) Brukeren åpner siden med oppgavelisten.\n2) Frontend sender en GET-forespørsel til /tasks.\n3) Backend mottar forespørselen og henter oppgavene, eventuelt fra databasen.\n4) Backend sender oppgavene tilbake som JSON.\n5) Frontend bruker dataene til å vise oppgavene på skjermen.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Eksempel: Hente oppgaver\n\nNår frontend skal hente oppgaver fra backend, kan kommunikasjonen foregå slik:\n\n1) Brukeren åpner siden med oppgavelisten.\n2) Frontend sender en GET-forespørsel til /tasks.\n3) Backend mottar forespørselen og henter oppgavene, eventuelt fra databasen.\n4) Backend sender oppgavene tilbake som JSON.\n5) Frontend bruker dataene til å vise oppgavene på skjermen.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
