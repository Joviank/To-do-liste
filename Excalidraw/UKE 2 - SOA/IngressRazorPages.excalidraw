      "isDeleted": true,
      "boundElements": [],
      "updated": 1791829976707,
      "link": null,
      "locked": false,
      "text": "Vi trenger ikke å vite hvor personen bor, men bare hva de heter.\nTelefonnummer fungerer som et grensesnitt.\n\nHvis vi endrer telefonnummeret, så vil vi ikke\nnå samme person\n\nHvis vi ikke får kontakt = Ting krasjer",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vi trenger ikke å vite hvor personen bor, men bare hva de heter.\nTelefonnummer fungerer som et grensesnitt.\n\nHvis vi endrer telefonnummeret, så vil vi ikke\nnå samme person\n\nHvis vi ikke får kontakt = Ting krasjer",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
