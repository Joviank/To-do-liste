    {
      "id": "01OyBfX9c4T0a0QTkYK8R",
      "type": "text",
      "x": 443.77602123392296,
      "y": 3140.196922131785,
      "width": 641.1952012482379,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
