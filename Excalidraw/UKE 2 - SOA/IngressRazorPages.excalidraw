      "link": null,
      "locked": false,
      "text": "Ingress forteller hvor trafikken skal gå.\nReverse proxy sørger for at den faktisk kommer dit",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ingress forteller hvor trafikken skal gå.\nReverse proxy sørger for at den faktisk kommer dit",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "e7RXSVXIDHsVZvVuEVPO0",
      "type": "text",
      "x": 239.36463984226833,
      "y": 2439.69318305641,
      "width": 990.3992919921875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2S",
      "roundness": null,
      "seed": 890014812,
      "version": 829,
      "versionNonce": 2049903253,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792397310009,
      "link": null,
      "locked": false,
      "text": "Ingress = Kubernets-regler som beskriver hvordan innkommende trafikk skal rutes\nProxy = En mellommann som videresender trafikk\nReverse proxy = Mottar forespørsler fra klienter og sender den til riktig backend tjeneste\n\nIngress controller = Programmet (NGINX, Traefik, HAProxy etc.) som leser ingress reglene og fungerer\nsom en reverse proxy",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ingress = Kubernets-regler som beskriver hvordan innkommende trafikk skal rutes\nProxy = En mellommann som videresender trafikk\nReverse proxy = Mottar forespørsler fra klienter og sender den til riktig backend tjeneste\n\nIngress controller = Programmet (NGINX, Traefik, HAProxy etc.) som leser ingress reglene og fungerer\nsom en reverse proxy",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
