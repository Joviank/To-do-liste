      "isDeleted": false,
      "boundElements": [],
      "updated": 1791834211408,
      "created": 1791834143081,
      "link": null,
      "locked": false,
      "text": "HTTP: Hvordan frontend og backend kommuniserer.\nEndpoint: Adressen frontend sender forespørselen til.\nJSON: Formatet dataene sendes i.\nRequest / Response: Forespørselen som sendes, og svaret som\nkommer tilbake.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTTP: Hvordan frontend og backend kommuniserer.\nEndpoint: Adressen frontend sender forespørselen til.\nJSON: Formatet dataene sendes i.\nRequest / Response: Forespørselen som sendes, og svaret som kommer tilbake.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "qPJxWwPy2lSEiDwTyYEpk",
      "type": "rectangle",
      "x": 235.992982411394,
      "y": 2763.6225308351586,
      "width": 989.9881640353017,
      "height": 343.0042346822215,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
